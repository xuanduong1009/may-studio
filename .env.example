# Copy to .env.local for local development, or add these in Vercel → Settings → Environment Variables.

# Database: local SQLite file, or a Turso database in production (libsql://...)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Generate with: npx @better-auth/cli secret   (or any random 32+ char string)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the site, e.g. https://may-studio.vercel.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that get the admin role when they sign up
ADMIN_EMAILS=admin@may.studio
# Password for the admin account created by "npm run db:seed"
SEED_ADMIN_PASSWORD=admin12345

# ---------------------------------------------------------------------------
# Optional integrations. Leave empty and the store still works in demo mode.
# ---------------------------------------------------------------------------

# Email (https://resend.com). Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="MÂY Studio <orders@your-domain.com>"

# VietQR bank transfer: your bank's 6-digit BIN (e.g. Vietcombank 970436, MB 970422,
# Techcombank 970407, ACB 970416) and account. Without these the QR is a demo.
BANK_BIN=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
BANK_NAME=

# Automatic payment confirmation from SePay (https://sepay.vn) webhooks:
# point SePay at https://<your-site>/api/payments/bank-webhook with "Apikey <this value>".
SEPAY_WEBHOOK_KEY=

# VNPay gateway. Free sandbox credentials: https://sandbox.vnpayment.vn/devreg/
# IPN URL to register: https://<your-site>/api/payments/vnpay/ipn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Extra origins allowed to sign in, e.g. a temporary tunnel used by "npm run share"
BETTER_AUTH_TRUSTED_ORIGINS=https://*.trycloudflare.com

# Show the demo account shortcuts on the sign-in page (rebuild after changing)
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
